# ══════════════════════════════════════════════════════════════
#  Apex Multi-Asset Controller — Environment Variables
#  Copy to .env for local dev, or set directly in Railway.
# ══════════════════════════════════════════════════════════════

# ── Coinbase Advanced Trade API ────────────────────────────────
COINBASE_API_KEY=organizations/xxxx/apiKeys/xxxx
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END EC PRIVATE KEY-----\n"

# ── Kraken API ─────────────────────────────────────────────────
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret_base64

# ── Capital ────────────────────────────────────────────────────
# Total USDC equivalent across BOTH exchanges.
# With $250 Coinbase + $250 Kraken → 500
TOTAL_CAPITAL_USDC=500

# Fraction of available balance deployed per trade (0.40 = 40%)
# At $250/exchange this is ~$100 per position
POSITION_PCT=0.40

# ── Risk ───────────────────────────────────────────────────────
# Hard drawdown cap across entire portfolio (both exchanges).
# Controller halts and closes all positions if breached.
MAX_DRAWDOWN_PCT=20

# Take-profit: % gain from entry
TP_PCT=2.3

# Stop-loss: % loss from entry
SL_PCT=1.6

# Trailing stop activates after this % gain
TRAIL_TRIGGER_PCT=1.5

# Trail distance from peak (stop trails this % below highest price)
TRAIL_DIST_PCT=0.5

# ── Signal thresholds ──────────────────────────────────────────
# RSI buy threshold in RANGING regime (+ volume gate)
RSI_BUY=35

# RSI buy threshold in UPTREND regime (no volume gate)
RSI_BUY_UPTREND=38

# RSI exit — sell if RSI climbs above this (confirmed 3 loops)
RSI_EXIT=65

# Minimum volume ratio for RANGING entries (1.0 = at least average vol)
VOL_RATIO_MIN=1.0

# ── Indicators ─────────────────────────────────────────────────
RSI_PERIOD=14
EMA_PERIOD=20
EMA_SLOW_PERIOD=50
EMA_SLOPE_BARS=5

# ── Shorts (Kraken margin) ─────────────────────────────────────
# Leverage for XRP shorts on Kraken. 2 = 2x.
# Requires margin trading enabled on Kraken account.
SHORT_LEVERAGE=2

# ── Fees ───────────────────────────────────────────────────────
COINBASE_FEE=0.004     # 0.4% taker
KRAKEN_FEE=0.0026      # 0.26% taker (Kraken Intermediate tier)

# ── Cooldown after a stop-loss hit ─────────────────────────────
# Prevents immediately re-entering after being stopped out.
SL_COOLDOWN_SEC=1800   # 30 minutes

# ── Loop timing ────────────────────────────────────────────────
LOOP_SLEEP=30          # seconds between each scan

# ── Data directory (Railway Volume mount point) ─────────────────
DATA_DIR=/data
